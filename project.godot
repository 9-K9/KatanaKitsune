; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="KatanaKitsune (Isometric)"
config/tags=PackedStringArray("template")
run/main_scene="res://scenes/world/maps/mapTemplate.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
CheatManager="*res://scripts/system/CheatManager.gd"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={
"mummyKitsune_taunt": "res://dialogue/enemies/mummyKitsune_taunt.dtl",
"timeline": "res://dialogue/_test/timeline.dtl",
"undeadRonin_taunt": "res://dialogue/enemies/undeadRonin_taunt.dtl"
}
layout/style_list=[]
layout/default_style=""
glossary/default_case_sensitive=true
layout/style_directory={}

[display]

window/size/viewport_width=1536
window/size/viewport_height=864
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/finite_state_machine/plugin.cfg")

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false

